// Esther's cards, drawn natively with Slint: the header with the greeting, the calendar, This week, Tasks, and the
// Esther bubble. Each card is its own window (a `Card`, told which one it is by `kind`); what it shows and what it
// does goes through the `Esther` global, which the program fills for every window from the one shared set of tasks.
// The look follows Esther's "Gilded" theme: warm dark panels over the glass, gold highlights, Instrument Serif.
import { ListView } from "std-widgets.slint";
import "fonts/InstrumentSerif-Regular.ttf";
import "fonts/InstrumentSerif-Italic.ttf";

export struct ListTab { id: string, name: string, color: color, open: int, total: int }
export struct SubRow { id: string, text: string, done: bool }
export struct TaskRow {
    id: string,
    title: string,
    done: bool,
    list-id: string,
    list-name: string,
    list-color: color,
    date: string,
    // the date as YYYY-MM-DD ("" for none), for the date picker
    iso: string,
    // 0 no date, 1 today, 2 late, 3 later
    date-kind: int,
    subs: string,
    subs-done: int,
    subtasks: [SubRow],
    clears: string,
}
// A day on a calendar: its number, its date, open-task dots in their lists' colours.
export struct CalDay { num: int, iso: string, today: bool, picked: bool, other: bool, marks: [color] }
// A day in This week (or the "Still open from before" group), with its tasks.
export struct WeekDay { label: string, small: string, today: bool, past: bool, late: bool, tasks: [TaskRow] }
export struct Pigment { name: string, color: color }
export struct Choice { id: string, label: string, hint: string, on: bool }
export struct Swatch { color: color, on: bool }
export struct LookChoice { id: string, label: string, blurb: string, swatches: [color], on: bool }

export global Look {
    in-out property <color> text: #f2ede3;
    in-out property <color> muted: #b9af9d;
    in-out property <color> faint: #82796a;
    in-out property <color> accent: #d9a63a;
    in-out property <color> accent-ink: #15110c;
    out property <color> danger: #e5604a;
    out property <color> general: #e0694c;
    out property <color> lapis: #6f93df;
    in-out property <color> panel: #191613;
    in-out property <color> pop: #1d1a16;
    in-out property <color> edge: #ffffff14;
    // How much of the panel colour lies over Windows' acrylic (the rest is the glass).
    in-out property <float> acrylic-tint: 0.5;
    // The colours a list can have (as in the app).
    out property <[Pigment]> pigments: [
        { name: "Vermilion", color: #c8553a }, { name: "Lapis", color: #4c6fb8 }, { name: "Verdigris", color: #3f9a80 },
        { name: "Orpiment", color: #d4a03c }, { name: "Madder", color: #b44a6e }, { name: "Tyrian", color: #8a4f8f },
        { name: "Azurite", color: #5a93c4 }, { name: "Malachite", color: #6aa452 },
    ];
}

// What the Settings card shows (set from the program) and what it asks for: `set(key, value)`.
export global Settings {
    in-out property <string> section: "desktop";
    in property <string> keys: "Ctrl+Alt+E";
    in property <string> keys-note;
    in property <bool> recording;
    in property <bool> bubble;
    in property <float> bubble-size: 0.6;
    in property <bool> snap;
    in property <bool> startup;
    in property <[Choice]> cards;
    in property <[LookChoice]> looks;
    in property <[Swatch]> panels;
    in property <[Swatch]> accents;
    in property <float> opacity: 0.5;
    in property <bool> acrylic-ok;
    in property <string> glass: "acrylic";
    in property <float> blur: 24;
    in property <[Choice]> clear-choices;
    in property <string> copy-note;
    in property <string> version;
    in property <string> memory;
    callback set(string, string);
    // Picking new keys: started or stopped, and each key pressed meanwhile.
    callback record(bool);
    callback keys-pressed(string, bool, bool, bool, bool);
    callback close();
}

// Everything a card shows and can do. Each window has its own copy; the program keeps them all in step.
export global Esther {
    // Tasks
    in property <[ListTab]> tabs;
    in property <string> tab: "all";
    in property <int> show: 0;
    in property <int> count-all;
    in property <int> count-open;
    in property <int> count-done;
    in property <int> count-tab-all;
    in property <[TaskRow]> rows;
    in property <string> empty-text: "Nothing to do here. Add a task above.";
    in property <string> add-list-name;
    in property <color> add-list-color;
    // False until the shared tasks file exists (written by the Esther app), so nothing here can overwrite your tasks.
    in property <bool> can-add: true;
    // Narrow (set from Rust as the card is resized): no column headings, the list as a dot.
    in property <bool> compact;
    // The day picked on the calendar ("" for every day), as shown on the Tasks card, and a task to point out.
    in property <string> day-label;
    in property <string> highlight;
    // The task whose subtasks are open, and the list being renamed.
    in-out property <string> open-task;
    in-out property <string> renaming-list;
    // The date picker's month.
    in property <string> picker-title;
    in property <[CalDay]> picker-days;
    // Header
    in property <string> hello: "Good morning";
    in property <string> hello-letter: "G";
    in property <string> long-date;
    in property <string> line;
    // Calendar
    in property <string> month-title;
    in property <[CalDay]> days;
    // This week
    in property <string> week-range;
    in property <[WeekDay]> week;

    callback pick-tab(string);
    callback pick-show(int);
    callback add-task(string);
    callback next-add-list();
    callback toggle(string);
    callback rename(string, string);
    // (task, "today" | "tomorrow" | "next-week" | "none" | YYYY-MM-DD)
    callback set-date(string, string);
    callback move-to(string, string);
    callback delete(string);
    callback sub-add(string, string);
    callback sub-toggle(string, string);
    callback sub-rename(string, string, string);
    callback sub-delete(string, string);
    callback add-list();
    callback rename-list(string, string);
    callback recolor-list(string, color);
    // (list, move its tasks to the first other list)
    callback delete-list(string, bool);
    // Open the date picker on a task's date (or this month), and move it a month.
    callback picker-open(string);
    callback picker-step(int);
    callback clear-day();
    callback pick-day(string);
    // -1 the month before, 1 the month after, 0 this month
    callback month-step(int);
    callback reveal(string);
    // The table: column widths (dragged from the headings), sorting, dragging tasks and lists, undo.
    in-out property <length> col-list: 150px;
    in-out property <length> col-subs: 110px;
    in-out property <length> col-date: 120px;
    callback cols-changed();
    in property <string> sort-col;
    in property <bool> sort-asc: true;
    callback sort-by(string);
    callback unsort();
    // A text field with text in it has the keyboard (then Ctrl+Z is the text's, not Esther's).
    in-out property <bool> typing;
    in-out property <string> drag-task;
    in-out property <length> drag-y;
    in-out property <string> drop-task;
    in-out property <bool> drop-after;
    callback move-task(string, string, bool);
    in-out property <string> drag-list;
    in-out property <length> drag-x;
    in-out property <string> drop-list;
    in-out property <bool> drop-list-after;
    callback move-list(string, string, bool);
    callback undo();
    // The new task's list and date (chosen in the add row).
    callback set-add-list(string);
    in property <string> add-date-label;
    in property <string> add-date-iso;
    callback reset-layout();
    callback hide-all();
    callback open-settings();
    callback quit();
    callback bubble-click();
    callback bubble-wheel(float);

    callback drag-start();
    callback resize-start(string);
    callback drag-by(length, length);
    callback drag-end();
    callback resize-by(string, length, length);
    callback resize-end();
}

// The space a card is picked up and moved by.
component DragArea inherits TouchArea {
    moved => { if self.pressed { Esther.drag-by(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); } }
    pointer-event(e) => {
        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { Esther.drag-start(); }
        if e.kind == PointerEventKind.up { Esther.drag-end(); }
    }
}

component Dot inherits VerticalLayout {
    in property <color> color;
    in property <length> size: 7px;
    alignment: center;
    Rectangle { width: root.size; height: root.size; border-radius: root.size / 2; background: root.color; }
}

// A rounded rectangle (a pill or a circle when the radius is half its height) drawn as a path: the path drawing
// smooths its edges properly at any display scale, where a plain rectangle's border looks ragged on the curves.
component Shape inherits Path {
    in property <length> radius: self.height / 2;
    in property <length> line: 1px;
    property <float> w: max(1, self.width / 1px);
    property <float> h: max(1, self.height / 1px);
    // (The outline runs half its width inside the edge, so none of it is cut off.)
    property <float> i: self.line / 2px;
    property <float> r: max(0, min(self.radius / 1px, min(self.w, self.h) / 2));
    property <float> a: max(0, self.r - self.i);
    viewbox-width: self.w;
    viewbox-height: self.h;
    stroke-width: self.line;
    commands: "M" + self.r + " " + self.i
        + " L" + (self.w - self.r) + " " + self.i
        + " A" + self.a + " " + self.a + " 0 0 1 " + (self.w - self.i) + " " + self.r
        + " L" + (self.w - self.i) + " " + (self.h - self.r)
        + " A" + self.a + " " + self.a + " 0 0 1 " + (self.w - self.r) + " " + (self.h - self.i)
        + " L" + self.r + " " + (self.h - self.i)
        + " A" + self.a + " " + self.a + " 0 0 1 " + self.i + " " + (self.h - self.r)
        + " L" + self.i + " " + self.r
        + " A" + self.a + " " + self.a + " 0 0 1 " + self.r + " " + self.i + " Z";
}

// A pill: list tabs, the To do / Done switch, chips.
component Pill inherits Rectangle {
    in property <string> text;
    in property <string> count;
    in property <color> dot;
    in property <bool> show-dot;
    in property <bool> on;
    in property <length> pad: 12px;
    in property <length> font-size: 13.5px;
    callback clicked;
    callback double-clicked;
    height: 30px;
    Shape {
        width: 100%;
        height: 100%;
        fill: root.on ? Look.accent.with-alpha(0.22) : ta.has-hover ? #ffffff17 : #ffffff0b;
        stroke: root.on ? Look.accent.with-alpha(0.55) : #ffffff1f;
        animate fill { duration: 120ms; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } double-clicked => { root.double-clicked(); } }
    HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: 7px;
        if root.show-dot: Dot { color: root.dot; }
        Text { text: root.text; color: root.on ? Look.text : Look.muted; vertical-alignment: center; font-size: root.font-size; }
        if root.count != "": Text { text: root.count; color: root.on ? Look.text : Look.faint; vertical-alignment: center; font-size: 11.5px; }
    }
}

component Check inherits Rectangle {
    in property <bool> checked;
    in property <length> size: 20px;
    callback toggled;
    width: root.size;
    height: root.size;
    Shape {
        width: 100%;
        height: 100%;
        line: 1.5px;
        fill: root.checked ? Look.accent : transparent;
        stroke: root.checked ? Look.accent : ta.has-hover ? Look.text : Look.faint;
        animate fill, stroke { duration: 120ms; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
    if root.checked: Text { text: "✓"; color: Look.accent-ink; font-size: root.size * 0.6; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
}

// The + for a new list: a circle, and a plus drawn as two lines, in the middle.
component AddButton inherits Rectangle {
    callback clicked;
    width: 30px;
    height: 30px;
    Shape {
        width: 100%;
        height: 100%;
        fill: ta.has-hover ? #ffffff17 : #ffffff0b;
        stroke: #ffffff1f;
        animate fill { duration: 120ms; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Rectangle { x: (parent.width - 12px) / 2; y: (parent.height - 1.5px) / 2; width: 12px; height: 1.5px; border-radius: 0.75px; background: ta.has-hover ? Look.text : Look.muted; }
    Rectangle { x: (parent.width - 1.5px) / 2; y: (parent.height - 12px) / 2; width: 1.5px; height: 12px; border-radius: 0.75px; background: ta.has-hover ? Look.text : Look.muted; }
}

// Typing never looks like a text box: just the text, a caret, and a faint line under it while focused.
// Enter saves (accepted); clicking away saves too (left); Esc cancels.
component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    in property <length> font-size: 14px;
    in property <color> ink: Look.text;
    callback accepted(string);
    callback cancelled;
    callback left(string);
    public function grab-focus() { input.focus(); }
    public function select-all() { input.select-all(); }
    height: 30px;
    if input.text == "": Text { x: 0; width: parent.width; text: root.placeholder; color: Look.faint; font-size: root.font-size; vertical-alignment: center; height: parent.height; overflow: elide; }
    input := TextInput {
        x: 0;
        width: parent.width;
        height: parent.height;
        color: root.ink;
        font-size: root.font-size;
        vertical-alignment: center;
        selection-background-color: Look.accent.with-alpha(0.35);
        single-line: true;
        // (Done with it: Enter or Esc. The field may go away now, without losing the keyboard first.)
        accepted => { Esther.typing = false; root.accepted(self.text); }
        edited => { Esther.typing = self.text != ""; }
        key-pressed(e) => { if e.text == Key.Escape { Esther.typing = false; root.cancelled(); return accept; } reject }
        changed has-focus => { if !self.has-focus { root.left(self.text); } Esther.typing = self.has-focus && self.text != ""; }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: input.has-focus ? Look.accent.with-alpha(0.6) : transparent; }
}

// Text you click to edit (Enter or clicking away saves, Esc cancels), like the app's.
component Editable inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 14px;
    in property <bool> struck;
    in property <color> ink: Look.text;
    callback saved(string);
    property <bool> editing;
    property <bool> done-editing;
    if !root.editing: TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { root.done-editing = false; root.editing = true; }
        t := Text {
            x: 0;
            width: parent.width;
            text: root.text;
            color: root.ink;
            font-size: root.font-size;
            vertical-alignment: center;
            overflow: elide;
        }
        // Crossed out when it's done.
        if root.struck: Rectangle { x: 0; y: parent.height / 2; height: 1px; width: min(t.preferred-width, parent.width); background: Look.faint; }
    }
    if root.editing: Field {
        y: (parent.height - self.height) / 2;
        text: root.text;
        font-size: root.font-size;
        init => { self.grab-focus(); self.select-all(); }
        accepted(s) => { if !root.done-editing { root.done-editing = true; if s != root.text && s != "" { root.saved(s); } } root.editing = false; }
        left(s) => { if !root.done-editing { root.done-editing = true; if s != root.text && s != "" { root.saved(s); } } root.editing = false; }
        cancelled => { root.done-editing = true; root.editing = false; }
    }
}

// Right-click a task (anywhere): its date, its list, delete it.
component TaskMenu inherits ContextMenuArea {
    in property <string> id;
    in property <string> list-id;
    in property <bool> has-subtasks;
    Menu {
        MenuItem { title: Esther.open-task == root.id ? "Hide subtasks" : root.has-subtasks ? "Show subtasks" : "Add subtasks"; activated => { Esther.open-task = Esther.open-task == root.id ? "" : root.id; } }
        MenuSeparator { }
        MenuItem { title: "Today"; activated => { Esther.set-date(root.id, "today"); } }
        MenuItem { title: "Tomorrow"; activated => { Esther.set-date(root.id, "tomorrow"); } }
        MenuItem { title: "Next week"; activated => { Esther.set-date(root.id, "next-week"); } }
        MenuItem { title: "No date"; activated => { Esther.set-date(root.id, "none"); } }
        MenuSeparator { }
        Menu {
            title: "Move to";
            for l in Esther.tabs: MenuItem { title: l.name; checkable: true; checked: l.id == root.list-id; activated => { Esther.move-to(root.id, l.id); } }
        }
        MenuSeparator { }
        MenuItem { title: "Delete task"; activated => { Esther.delete(root.id); } }
    }
}

// ---- Calendars: the calendar card and the date picker ----
component DayCell inherits Rectangle {
    in property <CalDay> day;
    in property <length> slot-w: 38px;
    in property <length> slot-h: 38px;
    in property <length> font-size: 18px;
    callback picked(string);
    width: min(38px, self.slot-w);
    height: min(38px, self.slot-h);
    Shape {
        width: 100%;
        height: 100%;
        radius: 10px;
        line: root.day.today && !root.day.picked ? 1.5px : 1px;
        fill: root.day.picked && root.day.today ? Look.accent : root.day.picked ? Look.accent.with-alpha(0.2) : ta.has-hover ? #ffffff14 : transparent;
        stroke: root.day.picked && root.day.today ? transparent : root.day.today ? Look.accent : root.day.picked ? Look.accent.with-alpha(0.4) : transparent;
        animate fill { duration: 120ms; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.picked(root.day.iso); } }
    Text {
        y: (parent.height - self.height) / 2 - 1px;
        text: root.day.num;
        font-family: "Instrument Serif";
        font-italic: true;
        font-size: root.font-size;
        horizontal-alignment: center;
        color: root.day.picked && root.day.today ? Look.accent-ink : root.day.today ? Look.accent : root.day.other ? Look.faint : Look.text;
    }
    HorizontalLayout {
        y: parent.height - 8px;
        height: 4px;
        alignment: center;
        spacing: 3px;
        for m[i] in root.day.marks: Rectangle {
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: root.day.picked && root.day.today ? Look.accent-ink : m;
        }
    }
}

// The gear: Settings.
component Gear inherits Rectangle {
    callback clicked;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: gta.has-hover ? #ffffff14 : transparent;
    gta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Path {
        x: 6px;
        y: 6px;
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: gta.has-hover ? Look.text : Look.muted;
        stroke-width: 1.4px;
        commands: "M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M15 12a3 3 0 1 1-6 0a3 3 0 1 1 6 0z";
    }
}

component NavButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: ta.has-hover ? #ffffff14 : transparent;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Text { text: root.text; color: Look.muted; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
}

// A month of days, Monday first, filling the space it's given.
component MonthGrid inherits Rectangle {
    in property <[CalDay]> days;
    in property <length> font-size: 18px;
    callback picked(string);
    property <int> weeks: max(1, root.days.length / 7);
    property <length> cw: self.width / 7;
    property <length> ch: self.height / self.weeks;
    for d[i] in root.days: Rectangle {
        x: mod(i, 7) * root.cw;
        y: floor(i / 7) * root.ch;
        width: root.cw;
        height: root.ch;
        DayCell { day: d; slot-w: root.cw - 2px; slot-h: root.ch - 2px; font-size: root.font-size; picked(iso) => { root.picked(iso); } }
    }
}

component WeekLetters inherits HorizontalLayout {
    height: 16px;
    for d in ["M", "T", "W", "T", "F", "S", "S"]: Text { horizontal-stretch: 1; text: d; color: Look.faint; font-size: 11px; horizontal-alignment: center; }
}

// The date picker: Today / Tomorrow / Next week, a small month (‹ › to move), and No date.
component DatePicker inherits Rectangle {
    in property <string> task;
    in property <bool> has-date;
    callback done;
    width: 264px;
    height: 330px;
    background: Look.pop;
    border-radius: 12px;
    drop-shadow-blur: 18px;
    drop-shadow-color: #00000080;
    Shape { width: 100%; height: 100%; radius: 12px; fill: transparent; stroke: #ffffff1f; }
    TouchArea { } // (clicks on the picker's background stay in the picker)
    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        HorizontalLayout {
            height: 28px;
            Text { horizontal-stretch: 1; text: Esther.picker-title; color: Look.text; font-family: "Instrument Serif"; font-size: 19px; vertical-alignment: center; }
            NavButton { text: "‹"; clicked => { Esther.picker-step(-1); } }
            NavButton { text: "›"; clicked => { Esther.picker-step(1); } }
        }
        HorizontalLayout {
            spacing: 6px;
            height: 28px;
            alignment: start;
            Pill { height: 28px; text: "Today"; pad: 10px; font-size: 12.5px; clicked => { Esther.set-date(root.task, "today"); root.done(); } }
            Pill { height: 28px; text: "Tomorrow"; pad: 10px; font-size: 12.5px; clicked => { Esther.set-date(root.task, "tomorrow"); root.done(); } }
            Pill { height: 28px; text: "Next week"; pad: 10px; font-size: 12.5px; clicked => { Esther.set-date(root.task, "next-week"); root.done(); } }
        }
        WeekLetters { }
        MonthGrid {
            vertical-stretch: 1;
            days: Esther.picker-days;
            font-size: 16px;
            picked(iso) => { Esther.set-date(root.task, iso); root.done(); }
        }
        HorizontalLayout {
            height: 28px;
            alignment: start;
            if root.has-date: Pill { height: 28px; text: "No date"; pad: 10px; font-size: 12.5px; clicked => { Esther.set-date(root.task, "none"); root.done(); } }
        }
    }
}

// A little chevron: › closed, ⌄ open (drawn, so it's crisp and centred).
component Chevron inherits Path {
    in property <bool> open;
    in property <color> ink: Look.faint;
    width: 12px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 12;
    stroke: root.ink;
    stroke-width: 1.4px;
    fill: transparent;
    commands: root.open ? "M3 4.5 L6 7.5 L9 4.5" : "M4.5 3 L7.5 6 L4.5 9";
}

// A small calendar, for the date chips.
component CalendarIcon inherits Path {
    in property <color> ink: Look.faint;
    width: 12px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 12;
    stroke: root.ink;
    stroke-width: 1.1px;
    fill: transparent;
    commands: "M2 3.2 Q2 2.2 3 2.2 L9 2.2 Q10 2.2 10 3.2 L10 9.6 Q10 10.6 9 10.6 L3 10.6 Q2 10.6 2 9.6 Z M2 5 L10 5 M4.2 1.2 L4.2 3 M7.8 1.2 L7.8 3";
}

// ⠿: hold it to drag a task or a list to another place.
component Grip inherits Rectangle {
    in property <bool> shown: true;
    in property <bool> hot;
    width: 16px;
    for d in [{ x: 4px, y: 3px }, { x: 9px, y: 3px }, { x: 4px, y: 7.5px }, { x: 9px, y: 7.5px }, { x: 4px, y: 12px }, { x: 9px, y: 12px }]: Rectangle {
        x: d.x;
        y: (parent.height - 15px) / 2 + d.y;
        width: 2.2px;
        height: 2.2px;
        border-radius: 1.1px;
        background: root.hot ? Look.muted : Look.faint;
        opacity: root.shown ? 1 : 0;
    }
}

// The date chip: the date (coloured: today gold, late red), or, on hover, a place to set one.
component DateChip inherits Rectangle {
    in property <string> label;
    in property <int> kind;
    in property <bool> hover;
    in property <string> empty: "Date";
    width: chip-row.preferred-width + 16px;
    height: 24px;
    border-radius: 12px;
    visible: root.kind != 0 || root.hover;
    background: root.kind == 1 ? Look.accent.with-alpha(0.16) : root.kind == 2 ? Look.danger.with-alpha(0.15) : #ffffff10;
    property <color> ink: root.kind == 1 ? Look.accent : root.kind == 2 ? Look.danger : Look.muted;
    chip-row := HorizontalLayout {
        x: 8px;
        spacing: 5px;
        VerticalLayout { alignment: center; CalendarIcon { ink: root.ink; } }
        Text { text: root.kind != 0 ? root.label : root.empty; font-size: 12.5px; vertical-alignment: center; color: root.ink; }
    }
}

// A column heading: click to sort by it (again for the other way); its left edge drags to make the column wider.
component Heading inherits Rectangle {
    in property <string> text;
    in property <string> column;
    in property <bool> resizable: true;
    // (When dragged, by how much the column's left edge moved.)
    callback resized(length);
    callback resize-done();
    property <bool> sorted: Esther.sort-col == root.column;
    ta := TouchArea { mouse-cursor: pointer; clicked => { Esther.sort-by(root.column); } }
    HorizontalLayout {
        spacing: 4px;
        alignment: start;
        Text {
            text: root.text;
            color: root.sorted || ta.has-hover ? Look.text : Look.faint;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.9px;
            vertical-alignment: center;
        }
        if root.sorted: Text { text: Esther.sort-asc ? "↑" : "↓"; color: Look.text; font-size: 11px; vertical-alignment: center; }
    }
    if root.resizable: edge := TouchArea {
        x: -8px;
        width: 8px;
        mouse-cursor: col-resize;
        moved => { if self.pressed { root.resized(self.mouse-x - self.pressed-x); } }
        pointer-event(e) => { if e.kind == PointerEventKind.up { root.resize-done(); } }
        Rectangle { x: 3px; width: 1px; height: parent.height; background: edge.has-hover || edge.pressed ? Look.accent.with-alpha(0.6) : transparent; }
    }
}

// One task: ⠿ to drag, tick, › for its subtasks, name (click to edit), list (click to change), subtasks (a bar and a
// count; click to open), date (click to pick). Right-click anywhere on it for the rest.
component Row inherits Rectangle {
    in property <TaskRow> task;
    in property <bool> show-list;
    in property <bool> compact;
    property <bool> open: Esther.open-task == root.task.id;
    property <length> line-h: 42px;
    property <bool> dragged: Esther.drag-task == root.task.id;
    // Where a dragged task would land: 1 above this one, 2 below.
    property <int> zone: Esther.drag-task == "" || root.dragged ? 0 : Esther.drag-y < root.y ? 0 : Esther.drag-y < root.y + root.height / 2 ? 1 : Esther.drag-y < root.y + root.height ? 2 : 0;
    changed zone => { if self.zone != 0 { Esther.drop-task = root.task.id; Esther.drop-after = self.zone == 2; } }
    height: root.open ? root.line-h + root.task.subtasks.length * 32px + 40px : root.line-h;
    border-radius: 8px;
    opacity: root.dragged ? 0.45 : 1;
    background: Esther.highlight == root.task.id ? Look.accent.with-alpha(0.14) : root.open ? #ffffff08 : hover.has-hover ? #ffffff0a : transparent;
    animate background { duration: 200ms; }
    hover := TouchArea { }
    HorizontalLayout {
        y: 0;
        height: root.line-h;
        padding-left: 0px;
        padding-right: 8px;
        spacing: 8px;
        // ⠿ (not while sorted: then the order is the sort's)
        grip := Rectangle {
            width: 16px;
            Grip { height: parent.height; shown: hover.has-hover && Esther.sort-col == ""; hot: gta.has-hover || gta.pressed; }
            gta := TouchArea {
                enabled: Esther.sort-col == "";
                mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        Esther.drop-task = "";
                        Esther.drag-y = root.y + self.mouse-y;
                        Esther.drag-task = root.task.id;
                    }
                    if e.kind == PointerEventKind.up {
                        if Esther.drop-task != "" && Esther.drop-task != root.task.id { Esther.move-task(root.task.id, Esther.drop-task, Esther.drop-after); }
                        Esther.drag-task = "";
                        Esther.drop-task = "";
                    }
                }
                moved => { if self.pressed { Esther.drag-y = root.y + self.mouse-y; } }
            }
        }
        VerticalLayout { alignment: center; Check { checked: root.task.done; toggled => { Esther.toggle(root.task.id); } } }
        // The name: › for subtasks, the list as a dot when narrow, the name, and "clears in N days".
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            Rectangle {
                width: 14px;
                cta := TouchArea { mouse-cursor: pointer; clicked => { Esther.open-task = root.open ? "" : root.task.id; } }
                Chevron { x: 1px; y: (parent.height - self.height) / 2; open: root.open; ink: cta.has-hover || root.open ? Look.text : Look.faint; }
            }
            if root.compact && root.show-list: Dot { color: root.task.list-color; }
            Editable {
                horizontal-stretch: 1;
                text: root.task.title;
                struck: root.task.done;
                ink: root.task.done ? Look.faint : Look.text;
                saved(s) => { Esther.rename(root.task.id, s); }
            }
            if root.task.clears != "": Text { text: root.task.clears; color: Look.faint; font-size: 11.5px; font-italic: true; vertical-alignment: center; }
        }
        // The list: click for the lists.
        if root.show-list && !root.compact: Rectangle {
            width: Esther.col-list;
            list-menu := ContextMenuArea {
                enabled: false;
                Menu {
                    for l in Esther.tabs: MenuItem { title: l.name; checkable: true; checked: l.id == root.task.list-id; activated => { Esther.move-to(root.task.id, l.id); } }
                }
            }
            list-pill := Rectangle {
                x: 0;
                width: min(parent.width, lp-row.preferred-width + 18px);
                height: 24px;
                y: (parent.height - self.height) / 2;
                border-radius: 12px;
                background: root.task.list-color.with-alpha(lp.has-hover ? 0.28 : 0.18);
                lp-row := HorizontalLayout {
                    x: 9px;
                    width: parent.width - 18px;
                    spacing: 6px;
                    Dot { color: root.task.list-color; }
                    Text { text: root.task.list-name; color: Look.text; font-size: 12.5px; vertical-alignment: center; overflow: elide; }
                }
                lp := TouchArea { mouse-cursor: pointer; clicked => { list-menu.show({ x: 0, y: list-pill.y + list-pill.height + 2px }); } }
            }
        }
        // Subtasks: a bar and n/m; click to open them (or "+ sub" to add the first).
        if root.task.subs != "" || !root.compact: Rectangle {
            width: root.compact ? subs-row.preferred-width + 6px : Esther.col-subs;
            subs-ta := TouchArea { mouse-cursor: pointer; clicked => { Esther.open-task = root.open ? "" : root.task.id; } }
            subs-row := HorizontalLayout {
                x: 0;
                spacing: 8px;
                alignment: start;
                if root.task.subtasks.length > 0: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 46px;
                        height: 4px;
                        border-radius: 2px;
                        background: #ffffff1a;
                        Rectangle { x: 0; width: parent.width * root.task.subs-done / max(1, root.task.subtasks.length); border-radius: 2px; background: Look.accent; }
                    }
                }
                Text {
                    text: root.task.subs != "" ? root.task.subs : subs-ta.has-hover || root.open ? "+ sub" : "—";
                    color: root.open || subs-ta.has-hover ? Look.accent : root.task.subs != "" ? Look.text : Look.faint;
                    font-size: 12.5px;
                    vertical-alignment: center;
                }
            }
        }
        // The date: click for the date picker.
        Rectangle {
            width: root.compact ? (root.task.date-kind != 0 ? chip.width : 0) : Esther.col-date;
            chip := DateChip { x: 0; y: (parent.height - self.height) / 2; label: root.task.date; kind: root.task.date-kind; hover: dt.has-hover; }
            dt := TouchArea { mouse-cursor: pointer; clicked => { Esther.picker-open(root.task.iso); picker.show(); } }
            picker := PopupWindow {
                x: root.compact ? -200px : min(0px, parent.width - 264px);
                y: chip.y + chip.height + 4px;
                width: 264px;
                height: 330px;
                close-policy: close-on-click-outside;
                DatePicker { task: root.task.id; has-date: root.task.date-kind != 0; done => { picker.close(); } }
            }
        }
    }
    // Subtasks, when open: tick, click to edit, right-click to delete; add one with Enter.
    if root.open: VerticalLayout {
        y: root.line-h;
        height: root.height - root.line-h;
        padding-left: 66px;
        padding-right: 8px;
        padding-bottom: 6px;
        for s in root.task.subtasks: Rectangle {
            height: 32px;
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout { alignment: center; Check { size: 16px; checked: s.done; toggled => { Esther.sub-toggle(root.task.id, s.id); } } }
                Editable {
                    horizontal-stretch: 1;
                    text: s.text;
                    font-size: 13.5px;
                    struck: s.done;
                    ink: s.done ? Look.faint : Look.muted;
                    saved(t) => { Esther.sub-rename(root.task.id, s.id, t); }
                }
            }
            // (On top, so a right-click anywhere on the subtask reaches it; other clicks pass through.)
            ContextMenuArea { Menu { MenuItem { title: "Delete subtask"; activated => { Esther.sub-delete(root.task.id, s.id); } } } }
        }
        HorizontalLayout {
            height: 34px;
            spacing: 10px;
            Rectangle {
                width: 16px;
                Rectangle { x: 3px; y: (parent.height - 1.5px) / 2; width: 10px; height: 1.5px; background: Look.faint; }
                Rectangle { x: 7.25px; y: (parent.height - 10px) / 2; width: 1.5px; height: 10px; background: Look.faint; }
            }
            sub-add := Field {
                y: 2px;
                horizontal-stretch: 1;
                font-size: 13.5px;
                placeholder: "Add a subtask, Enter";
                accepted(t) => { if t != "" { Esther.sub-add(root.task.id, t); self.text = ""; } }
                init => { if root.task.subtasks.length == 0 { self.grab-focus(); } }
            }
        }
    }
    Rectangle { y: root.line-h - 1px; height: 1px; background: Look.edge; }
    // Where a dragged task will land.
    if Esther.drag-task != "" && Esther.drop-task == root.task.id: Rectangle {
        y: Esther.drop-after ? root.height - 2px : 0px;
        height: 2px;
        border-radius: 1px;
        background: Look.accent;
    }
    // Right-click anywhere on the task (on top, so the name and the rest don't keep the right button to themselves;
    // left clicks pass through to them).
    TaskMenu { id: root.task.id; list-id: root.task.list-id; has-subtasks: root.task.subtasks.length > 0; y: 0; height: root.line-h; }
}

// ---- The Tasks card ----

// A list tab: click to show it, double-click to rename, drag it elsewhere, right-click for its colour, rename, delete.
component ListPill inherits Rectangle {
    in property <ListTab> list;
    // (Its width, from the name and the count, as the pill lays them out.)
    property <length> name-w: name-measure.preferred-width;
    property <length> count-w: count-measure.preferred-width;
    property <bool> dragged: Esther.drag-list == root.list.id;
    // (Pressed and moved: a drag, not a click.)
    property <bool> moved-it;
    property <int> zone: Esther.drag-list == "" || root.dragged ? 0 : Esther.drag-x < root.x ? 0 : Esther.drag-x < root.x + root.width / 2 ? 1 : Esther.drag-x < root.x + root.width ? 2 : 0;
    changed zone => { if self.zone != 0 { Esther.drop-list = root.list.id; Esther.drop-list-after = self.zone == 2; } }
    width: Esther.renaming-list == root.list.id ? max(120px, root.name-w + 40px) : 6px + 14px + 7px + 7px + root.name-w + 7px + root.count-w + 12px;
    height: 30px;
    opacity: root.dragged ? 0.45 : 1;
    name-measure := Text { visible: false; text: root.list.name; font-size: 13.5px; }
    count-measure := Text { visible: false; text: root.list.open; font-size: 11.5px; }
    if Esther.renaming-list != root.list.id: Rectangle {
        Shape {
            width: 100%;
            height: 100%;
            fill: Esther.tab == root.list.id ? Look.accent.with-alpha(0.22) : pta.has-hover ? #ffffff17 : #ffffff0b;
            stroke: Esther.tab == root.list.id ? Look.accent.with-alpha(0.55) : #ffffff1f;
        }
        // Click to show it, double-click to rename; drag it (anywhere on it) to put it elsewhere.
        pta := TouchArea {
            mouse-cursor: root.dragged ? MouseCursor.grabbing : MouseCursor.pointer;
            clicked => { if !root.moved-it { Esther.pick-tab(root.list.id); } }
            double-clicked => { Esther.renaming-list = root.list.id; }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.moved-it = false; }
                if e.kind == PointerEventKind.up {
                    if root.dragged && Esther.drop-list != "" && Esther.drop-list != root.list.id { Esther.move-list(root.list.id, Esther.drop-list, Esther.drop-list-after); }
                    if root.dragged { Esther.drag-list = ""; Esther.drop-list = ""; }
                }
            }
            moved => {
                if self.pressed {
                    if Esther.drag-list == "" && abs(self.mouse-x - self.pressed-x) > 4px {
                        root.moved-it = true;
                        Esther.drop-list = "";
                        Esther.drag-list = root.list.id;
                    }
                    if root.dragged { Esther.drag-x = root.x + self.mouse-x; }
                }
            }
        }
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 12px;
            spacing: 7px;
            Rectangle {
                width: 14px;
                Grip { x: -1px; height: parent.height; shown: pta.has-hover || root.dragged; hot: root.dragged; }
            }
            Dot { color: root.list.color; }
            Text { text: root.list.name; color: Esther.tab == root.list.id ? Look.text : Look.muted; vertical-alignment: center; font-size: 13.5px; }
            Text { text: root.list.open; color: Esther.tab == root.list.id ? Look.text : Look.faint; vertical-alignment: center; font-size: 11.5px; }
        }
        // (On top, so a right-click anywhere on the tab reaches it.)
        ContextMenuArea {
            Menu {
                MenuItem { title: "Rename"; activated => { Esther.renaming-list = root.list.id; } }
                Menu {
                    title: "Colour";
                    for p in Look.pigments: MenuItem { title: p.name; checkable: true; checked: p.color == root.list.color; activated => { Esther.recolor-list(root.list.id, p.color); } }
                }
                MenuSeparator { }
                if root.list.total == 0: MenuItem { title: "Delete list"; enabled: Esther.tabs.length > 1; activated => { Esther.delete-list(root.list.id, false); } }
                if root.list.total > 0: Menu {
                    title: "Delete list…";
                    enabled: Esther.tabs.length > 1;
                    MenuItem { title: "Move its " + root.list.total + (root.list.total == 1 ? " task" : " tasks") + " to " + (Esther.tabs[0].id == root.list.id ? Esther.tabs[1].name : Esther.tabs[0].name) + ", then delete"; activated => { Esther.delete-list(root.list.id, true); } }
                    MenuItem { title: "Delete it with its " + root.list.total + (root.list.total == 1 ? " task" : " tasks"); activated => { Esther.delete-list(root.list.id, false); } }
                }
            }
        }
    }
    if Esther.renaming-list == root.list.id: Rectangle {
        Shape { width: 100%; height: 100%; fill: Look.accent.with-alpha(0.16); stroke: Look.accent.with-alpha(0.55); }
        name-field := Field {
            x: 12px;
            width: parent.width - 24px;
            font-size: 13.5px;
            text: root.list.name;
            init => { self.grab-focus(); self.select-all(); }
            accepted(t) => { Esther.rename-list(root.list.id, t); Esther.renaming-list = ""; }
            left(t) => { if Esther.renaming-list == root.list.id { Esther.rename-list(root.list.id, t); Esther.renaming-list = ""; } }
            cancelled => { Esther.renaming-list = ""; }
        }
    }
    // Where a dragged list will land.
    if Esther.drag-list != "" && Esther.drop-list == root.list.id: Rectangle {
        x: Esther.drop-list-after ? root.width + 1px : -4px;
        width: 2px;
        border-radius: 1px;
        background: Look.accent;
    }
}

component TasksBody inherits Rectangle {
    // (The column widths while a heading's edge is dragged.)
    property <length> list-w0;
    VerticalLayout {
        padding: 14px;
        padding-bottom: 8px;
        spacing: 10px;

        // List tabs, and + for a new list. The space around them moves the card. (Not while waiting.)
        Rectangle {
            height: 32px;
            opacity: Esther.can-add ? 1 : 0;
            DragArea { }
            HorizontalLayout {
                spacing: 6px;
                Flickable {
                    horizontal-stretch: 1;
                    content-width: max(tabs-row.preferred-width, self.width);
                    // (Not by dragging with the mouse: that moves a tab. The mouse wheel scrolls the tabs.)
                    mouse-drag-pan-enabled: false;
                    tabs-row := HorizontalLayout {
                        alignment: start;
                        spacing: 6px;
                        Pill { text: "All"; count: Esther.count-tab-all; on: Esther.tab == "all"; clicked => { Esther.pick-tab("all"); } }
                        for l in Esther.tabs: ListPill { list: l; }
                    }
                }
                // A new list (always at the right, however many lists there are).
                AddButton { y: 1px; clicked => { Esther.add-list(); } }
            }
        }

        // All / To do / Done, the day picked on the calendar, "Back to my order" when sorted; the rest moves the card.
        Rectangle {
            height: 30px;
            opacity: Esther.can-add ? 1 : 0;
            DragArea { }
            HorizontalLayout {
                alignment: start;
                spacing: 10px;
                Rectangle {
                    border-radius: 8px;
                    background: #ffffff0b;
                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;
                        for s[i] in ["All", "To do", "Done"]: Rectangle {
                            border-radius: 6px;
                            background: Esther.show == i ? Look.accent.with-alpha(0.2) : seg.has-hover ? #ffffff0d : transparent;
                            seg := TouchArea { mouse-cursor: pointer; clicked => { Esther.pick-show(i); } }
                            HorizontalLayout {
                                padding-left: 11px;
                                padding-right: 11px;
                                spacing: 6px;
                                Text { text: s; color: Esther.show == i ? Look.text : Look.muted; font-size: 13px; vertical-alignment: center; }
                                Text { text: i == 0 ? Esther.count-all : i == 1 ? Esther.count-open : Esther.count-done; color: Look.faint; font-size: 11.5px; vertical-alignment: center; }
                            }
                        }
                    }
                }
                // Picked on the calendar: only that day. The × shows every day again.
                if Esther.day-label != "": Pill {
                    text: Esther.day-label + "   ×";
                    on: true;
                    pad: 11px;
                    font-size: 13px;
                    clicked => { Esther.clear-day(); }
                }
                if Esther.sort-col != "": Rectangle {
                    width: back.preferred-width;
                    bta := TouchArea { mouse-cursor: pointer; clicked => { Esther.unsort(); } }
                    back := Text { text: "Back to my order"; color: bta.has-hover ? Look.text : Look.muted; font-size: 13px; vertical-alignment: center; height: parent.height; }
                }
            }
        }

        // Column headings (not when narrow): click to sort; drag a heading's left edge to widen its column.
        if !Esther.compact && Esther.can-add: HorizontalLayout {
            padding-left: 0px;
            padding-right: 8px;
            spacing: 8px;
            height: 26px;
            Rectangle { width: 16px + 8px + 20px + 8px + 14px; }
            Heading { horizontal-stretch: 1; text: "TASK"; column: "title"; resizable: false; }
            if Esther.tab == "all": Heading {
                width: Esther.col-list;
                text: "LIST";
                column: "list";
                resized(d) => { Esther.col-list = clamp(Esther.col-list - d, 80px, 320px); }
                resize-done => { Esther.cols-changed(); }
            }
            Heading {
                width: Esther.col-subs;
                text: "SUBTASKS";
                column: "subs";
                resized(d) => { Esther.col-subs = clamp(Esther.col-subs - d, 70px, 240px); }
                resize-done => { Esther.cols-changed(); }
            }
            Heading {
                width: Esther.col-date;
                text: "DATE";
                column: "date";
                resized(d) => { Esther.col-date = clamp(Esther.col-date - d, 90px, 240px); }
                resize-done => { Esther.cols-changed(); }
            }
        }

        // Waiting for the shared tasks file (written by the Esther app, 2.2 or later).
        if !Esther.can-add: Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                padding: 18px;
                spacing: 10px;
                Text { text: "Waiting for your tasks"; color: Look.text; font-family: "Instrument Serif"; font-size: 26px; horizontal-alignment: center; }
                Text {
                    text: "These cards show the same tasks as the Esther app. Update Esther to 2.2 or later (Settings → About → Check now, then Restart to update) and open it once: your lists and tasks appear here by themselves.";
                    color: Look.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Until then nothing can be added here, so these cards can never overwrite your tasks.";
                    color: Look.faint;
                    font-size: 12px;
                    font-italic: true;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
            }
        }

        // Add a task: its name, its list, its date (or the day picked on the calendar).
        if Esther.can-add: Rectangle {
            height: 44px;
            HorizontalLayout {
                padding-right: 8px;
                spacing: 8px;
                Rectangle { width: 16px; }
                Rectangle {
                    width: 20px;
                    Rectangle { x: (parent.width - 12px) / 2; y: (parent.height - 1.5px) / 2; width: 12px; height: 1.5px; background: Look.faint; }
                    Rectangle { x: (parent.width - 1.5px) / 2; y: (parent.height - 12px) / 2; width: 1.5px; height: 12px; background: Look.faint; }
                }
                Rectangle { width: 14px; }
                add := Field {
                    y: 7px;
                    horizontal-stretch: 1;
                    font-size: 14.5px;
                    placeholder: Esther.day-label != "" ? "Add a task for " + Esther.day-label + ", Enter" : "Add a task, Enter";
                    accepted(t) => { if t != "" && Esther.can-add { Esther.add-task(t); self.text = ""; } }
                }
                // Its list (on All: on a list's own tab, that list).
                if Esther.tab == "all" && !Esther.compact: Rectangle {
                    width: Esther.col-list;
                    add-list-menu := ContextMenuArea {
                        enabled: false;
                        Menu { for l in Esther.tabs: MenuItem { title: l.name; checkable: true; checked: l.name == Esther.add-list-name; activated => { Esther.set-add-list(l.id); } } }
                    }
                    al := TouchArea { mouse-cursor: pointer; clicked => { add-list-menu.show({ x: 0, y: parent.height - 6px }); } }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 6px;
                        Dot { color: Esther.add-list-color; }
                        Text { text: Esther.add-list-name; color: al.has-hover ? Look.text : Look.muted; font-size: 13px; vertical-alignment: center; }
                        VerticalLayout { alignment: center; Chevron { open: true; ink: Look.faint; } }
                    }
                }
                if !Esther.compact: Rectangle { width: Esther.col-subs; }
                if !Esther.compact: Rectangle {
                    width: Esther.col-date;
                    add-chip := DateChip { x: 0; y: (parent.height - self.height) / 2; label: Esther.add-date-label; kind: Esther.add-date-label != "" ? 3 : 0; hover: true; }
                    TouchArea { mouse-cursor: pointer; clicked => { Esther.picker-open(Esther.add-date-iso); add-picker.show(); } }
                    add-picker := PopupWindow {
                        x: min(0px, parent.width - 264px);
                        y: add-chip.y + add-chip.height + 4px;
                        width: 264px;
                        height: 330px;
                        close-policy: close-on-click-outside;
                        DatePicker { task: "-new-"; has-date: Esther.add-date-label != ""; done => { add-picker.close(); } }
                    }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Look.edge; }
        }

        // The tasks.
        if Esther.can-add && Esther.rows.length > 0: ListView {
            vertical-stretch: 1;
            for t in Esther.rows: Row {
                task: t;
                show-list: Esther.tab == "all";
                compact: Esther.compact;
            }
        }
        if Esther.can-add && Esther.rows.length == 0: Rectangle {
            vertical-stretch: 1;
            Text { y: 18px; width: parent.width; text: Esther.empty-text; color: Look.faint; font-italic: true; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
        }

        if !Esther.compact: Text {
            text: "Click a column to sort · drag ⠿ to reorder · right-click a row for more · Ctrl+Z undoes";
            color: Look.faint;
            font-size: 11.5px;
            overflow: elide;
        }
    }
}

// ---- The header: the emblem and name, the greeting, the date and the day's line ----

// A pointed arch with a starred lapis sky and an "E": Esther's emblem (drawn like the app's SVG, 44 × 54).
component Emblem inherits Rectangle {
    width: 44px;
    height: 54px;
    Path { width: 100%; height: 100%; viewbox-width: 44; viewbox-height: 54; fill: Look.accent; stroke: #3a2a1c; stroke-width: 0.8px;
        commands: "M3 53V22C3 10 14 2 22 1c8 1 19 9 19 21v31z"; }
    Path { width: 100%; height: 100%; viewbox-width: 44; viewbox-height: 54; fill: Look.lapis;
        commands: "M7 50V23C7 13 15 6 22 5c7 1 15 8 15 18v27z"; }
    Path { width: 100%; height: 100%; viewbox-width: 44; viewbox-height: 54; fill: Look.accent;
        commands: "M16 10.8L16.8 13.2 19.2 14 16.8 14.8 16 17.2 15.2 14.8 12.8 14 15.2 13.2zM27 6.8L27.8 9.2 30.2 10 27.8 10.8 27 13.2 26.2 10.8 23.8 10 26.2 9.2zM21 18.8L21.8 21.2 24.2 22 21.8 22.8 21 25.2 20.2 22.8 17.8 22 20.2 21.2zM11 22.8L11.8 25.2 14.2 26 11.8 26.8 11 29.2 10.2 26.8 7.8 26 10.2 25.2zM30 20.8L30.8 23.2 33.2 24 30.8 24.8 30 27.2 29.2 24.8 26.8 24 29.2 23.2z"; }
    Rectangle { x: 7px; y: 42px; width: 30px; height: 8px; background: Look.general; }
    Rectangle { x: 7px; y: 42px; width: 30px; height: 1px; background: Look.accent; }
    Text { x: 7px; y: 42px; width: 30px; height: 8px; text: "E"; color: Look.accent; font-family: "Instrument Serif"; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
}

// The greeting's first letter, gold on lapis in a vermilion frame, like a chapter opening.
component Initial inherits Rectangle {
    in property <string> letter;
    width: 38px;
    height: 38px;
    background: Look.general;
    Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        background: Look.lapis;
        border-width: 1px;
        border-color: Look.accent;
    }
    Text { text: root.letter; color: Look.accent; font-family: "Instrument Serif"; font-size: 27px; horizontal-alignment: center; vertical-alignment: center; }
}

component HeaderBody inherits Rectangle {
    DragArea { }
    Rectangle {
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 14px + 58px + 12px;
            spacing: 20px;
            // Double-click the emblem and name to put every card back where it started.
            brand := TouchArea {
                horizontal-stretch: 0;
                double-clicked => { Esther.reset-layout(); }
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { Esther.drag-start(); }
                    if e.kind == PointerEventKind.up { Esther.drag-end(); }
                }
                moved => { if self.pressed { Esther.drag-by(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); } }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;
                    VerticalLayout { alignment: center; Emblem { } }
                    HorizontalLayout {
                        Text { text: "E"; color: Look.accent; font-family: "Instrument Serif"; font-size: 30px; vertical-alignment: center; }
                        Text { text: "sther"; color: Look.text; font-family: "Instrument Serif"; font-size: 30px; vertical-alignment: center; }
                    }
                }
            }
            VerticalLayout { padding-top: 22px; padding-bottom: 22px; Rectangle { width: 1px; background: Look.edge; } }
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 16px;
                HorizontalLayout {
                    spacing: 8px;
                    horizontal-stretch: 0;
                    VerticalLayout { alignment: center; Initial { letter: Esther.hello-letter; } }
                    Text { text: Esther.hello; color: Look.text; font-family: "Instrument Serif"; font-size: 28px; vertical-alignment: center; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text { text: Esther.long-date; color: Look.muted; font-size: 13px; overflow: elide; }
                    Text { text: Esther.line; color: Look.text; font-family: "Instrument Serif"; font-italic: true; font-size: 17px; overflow: elide; }
                }
            }
        }
        // Settings, and hide (the shortcut or the bubble brings Esther back): always at the top right, however
        // narrow the header (the greeting and the date give way).
        HorizontalLayout {
            x: parent.width - 14px - self.width;
            y: 12px;
            width: self.preferred-width;
            height: 28px;
            spacing: 2px;
            Gear { clicked => { Esther.open-settings(); } }
            NavButton { text: "×"; clicked => { Esther.hide-all(); } }
        }
    }
    // Right-click anywhere on the header (on top, so the logo and the rest don't keep the right button; left
    // clicks pass through).
    ContextMenuArea {
        Menu {
            MenuItem { title: "Settings"; activated => { Esther.open-settings(); } }
            MenuItem { title: "Hide Esther"; activated => { Esther.hide-all(); } }
            MenuItem { title: "Put every card back"; activated => { Esther.reset-layout(); } }
            MenuSeparator { }
            MenuItem { title: "Quit Esther"; activated => { Esther.quit(); } }
        }
    }
}

// ---- The calendar: the month, open tasks as dots; click a day to see only that day on the Tasks card ----
component CalendarBody inherits Rectangle {
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            height: 30px;
            spacing: 4px;
            Rectangle {
                horizontal-stretch: 1;
                DragArea { }
                Text { x: 0; text: Esther.month-title; color: Look.text; font-family: "Instrument Serif"; font-size: 22px; vertical-alignment: center; height: parent.height; }
            }
            NavButton { y: 1px; text: "‹"; clicked => { Esther.month-step(-1); } }
            Pill { height: 28px; text: "Today"; pad: 10px; font-size: 12.5px; clicked => { Esther.month-step(0); } }
            NavButton { y: 1px; text: "›"; clicked => { Esther.month-step(1); } }
        }
        WeekLetters { }
        MonthGrid { vertical-stretch: 1; days: Esther.days; picked(iso) => { Esther.pick-day(iso); } }
    }
}

// ---- This week: Monday to Sunday, and anything still open from before ----

// A task in This week: tick it, or click it to show it on the Tasks card.
component Line inherits Rectangle {
    in property <TaskRow> task;
    in property <bool> show-date;
    height: 26px;
    border-radius: 6px;
    background: ta.has-hover ? #ffffff0d : transparent;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 8px;
        VerticalLayout { alignment: center; Check { size: 15px; checked: root.task.done; toggled => { Esther.toggle(root.task.id); } } }
        Rectangle {
            horizontal-stretch: 1;
            ta := TouchArea { mouse-cursor: pointer; clicked => { Esther.reveal(root.task.id); } }
            t := Text {
                x: 0;
                width: parent.width;
                text: root.task.title;
                color: root.task.done ? Look.faint : ta.has-hover ? Look.accent : Look.text;
                font-size: 13.5px;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.task.done: Rectangle { x: 0; y: parent.height / 2; height: 1px; width: min(t.preferred-width, parent.width); background: Look.faint; }
        }
        if root.task.subs != "": Text { text: root.task.subs; color: Look.faint; font-size: 11.5px; vertical-alignment: center; }
        if root.show-date && root.task.date != "": Text { text: root.task.date; color: root.task.date-kind == 2 ? Look.danger : Look.faint; font-size: 11.5px; vertical-alignment: center; }
        Dot { color: root.task.list-color; }
    }
    // On top, so a right-click reaches it past the tick and the name (left clicks go through).
    TaskMenu { id: root.task.id; list-id: root.task.list-id; has-subtasks: root.task.subtasks.length > 0; }
}

component WeekBody inherits Rectangle {
    VerticalLayout {
        padding: 16px;
        padding-right: 10px;
        spacing: 8px;
        Rectangle {
            height: 30px;
            DragArea { }
            HorizontalLayout {
                padding-right: 6px;
                Text { text: "This week"; color: Look.text; font-family: "Instrument Serif"; font-size: 22px; vertical-alignment: center; }
                Text { horizontal-stretch: 1; text: Esther.week-range; color: Look.faint; font-size: 12.5px; horizontal-alignment: right; vertical-alignment: center; }
            }
        }
        Flickable {
            vertical-stretch: 1;
            content-height: days.preferred-height;
            days := VerticalLayout {
                padding-right: 6px;
                spacing: 2px;
                for d in Esther.week: Rectangle {
                    border-radius: 8px;
                    background: d.late ? Look.danger.with-alpha(0.08) : d.today ? Look.accent.with-alpha(0.1) : transparent;
                    VerticalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: d.tasks.length > 0 || d.today ? 5px : 3px;
                        padding-bottom: d.tasks.length > 0 || d.today ? 6px : 3px;
                        spacing: 2px;
                        HorizontalLayout {
                            height: 18px;
                            spacing: 8px;
                            alignment: start;
                            Text {
                                text: d.label;
                                font-size: 12.5px;
                                font-weight: d.tasks.length > 0 || d.today ? 600 : 400;
                                color: d.late ? Look.danger : d.today ? Look.accent : d.past || d.tasks.length == 0 ? Look.faint : Look.muted;
                            }
                            if d.small != "": Text { text: d.small; font-size: 12.5px; color: Look.faint; }
                        }
                        for t in d.tasks: Line { task: t; show-date: d.late; }
                    }
                }
            }
        }
    }
}

// ---- The Esther bubble: the word "Esther". Click it to show or hide the cards; the mouse wheel sizes it. ----
component BubbleBody inherits Rectangle {
    // Just the word, as in the app: no box, a soft shadow under it so it reads on any wallpaper.
    property <length> size: self.height * 0.74;
    property <length> top: (self.height - self.size * 1.25) / 2 - self.height * 0.03;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Esther.bubble-click(); }
        scroll-event(e) => { Esther.bubble-wheel(e.delta-y / 1px); accept }
    }
    for o in [
        { x: 0px, y: 4px, a: 0.10 }, { x: -2px, y: 3px, a: 0.08 }, { x: 2px, y: 3px, a: 0.08 }, { x: 0px, y: 6px, a: 0.06 },
        { x: 0px, y: 1px, a: 0.35 },
    ]: Text {
        x: o.x;
        y: root.top + o.y;
        width: parent.width;
        height: root.size * 1.25;
        text: "Esther";
        font-family: "Instrument Serif";
        font-italic: true;
        font-size: root.size;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: #000000.with-alpha(o.a);
    }
    Text {
        y: root.top;
        width: parent.width;
        height: root.size * 1.25;
        text: "Esther";
        font-family: "Instrument Serif";
        font-italic: true;
        font-size: root.size;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: ta.has-hover ? Look.accent : Look.text;
        animate color { duration: 150ms; }
    }
}

// ---- A card: one window, with the glass behind it, its body, and its edges to resize by ----
// ---- Settings: its own card (the gear on the header, the header's right-click, or the tray menu) ----

// On or off: a capsule with a knob.
component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled;
    width: 38px;
    height: 22px;
    Shape {
        width: 100%;
        height: 100%;
        fill: root.on ? Look.accent : ta.has-hover ? #ffffff1f : #ffffff12;
        stroke: root.on ? Look.accent : #ffffff2a;
        animate fill { duration: 120ms; }
    }
    Rectangle {
        x: root.on ? parent.width - 19px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.on ? Look.accent-ink : Look.muted;
        animate x { duration: 120ms; easing: ease-out; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
}

// A value along a line (drag the knob, or click the line), and the value as words beside it.
component Slider inherits HorizontalLayout {
    in property <float> value;
    in property <float> min: 0;
    in property <float> max: 1;
    in property <string> shown;
    // While dragging, and when let go.
    callback moved-to(float);
    callback done(float);
    property <float> f: clamp((root.value - root.min) / (root.max - root.min), 0, 1);
    spacing: 10px;
    track := Rectangle {
        width: 150px;
        height: 22px;
        Rectangle { y: (parent.height - 4px) / 2; height: 4px; border-radius: 2px; background: #ffffff1a; }
        Rectangle { x: 0; y: (parent.height - 4px) / 2; height: 4px; width: parent.width * root.f; border-radius: 2px; background: Look.accent; }
        Rectangle {
            x: parent.width * root.f - 8px;
            y: (parent.height - 16px) / 2;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: ta.pressed || ta.has-hover ? Look.text : Look.muted;
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.moved-to(root.at(self.mouse-x)); }
                if e.kind == PointerEventKind.up && e.button == PointerEventButton.left { root.done(root.at(self.mouse-x)); }
            }
            moved => { if self.pressed { root.moved-to(root.at(self.mouse-x)); } }
        }
    }
    Text { width: 44px; text: root.shown; color: Look.muted; font-size: 12.5px; vertical-alignment: center; }
    pure function at(x: length) -> float {
        root.min + clamp(x / track.width, 0, 1) * (root.max - root.min)
    }
}

// A button with words on it.
component Button inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    callback clicked;
    width: t.preferred-width + 28px;
    height: 30px;
    Shape {
        width: 100%;
        height: 100%;
        radius: 8px;
        fill: ta.has-hover ? #ffffff17 : #ffffff0b;
        stroke: #ffffff22;
    }
    t := Text { text: root.text; color: root.danger ? Look.danger : Look.text; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Colours to pick from: round swatches, the picked one ringed.
component Swatches inherits HorizontalLayout {
    in property <[Swatch]> swatches;
    callback picked(int);
    spacing: 7px;
    alignment: end;
    for s[i] in root.swatches: Rectangle {
        width: 22px;
        height: 22px;
        if s.on: Shape { width: 100%; height: 100%; fill: transparent; stroke: Look.text; line: 1.5px; }
        Rectangle { x: 4px; y: 4px; width: 14px; height: 14px; border-radius: 7px; background: s.color; border-width: 1px; border-color: #ffffff26; }
        TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
    }
}

// One of a few choices, side by side.
component Choices inherits Rectangle {
    in property <[Choice]> choices;
    callback picked(string);
    border-radius: 8px;
    background: #ffffff0b;
    height: 30px;
    width: row.preferred-width;
    row := HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for c in root.choices: Rectangle {
            border-radius: 6px;
            background: c.on ? Look.accent.with-alpha(0.22) : cta.has-hover ? #ffffff0d : transparent;
            cta := TouchArea { mouse-cursor: pointer; clicked => { root.picked(c.id); } }
            HorizontalLayout {
                padding-left: 11px;
                padding-right: 11px;
                Text { text: c.label; color: c.on ? Look.text : Look.muted; font-size: 12.5px; vertical-alignment: center; }
            }
        }
    }
}

// The keys that show and hide Esther: click, then press the new ones (with Ctrl, Alt or the Windows key).
component KeysButton inherits Rectangle {
    width: max(120px, t.preferred-width + 28px);
    height: 30px;
    Shape {
        width: 100%;
        height: 100%;
        radius: 8px;
        fill: Settings.recording ? Look.accent.with-alpha(0.2) : ta.has-hover ? #ffffff17 : #ffffff0b;
        stroke: Settings.recording ? Look.accent.with-alpha(0.7) : #ffffff22;
    }
    t := Text { text: Settings.recording ? "Press keys…" : Settings.keys; color: Look.text; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { Settings.record(true); fs.focus(); } }
    fs := FocusScope {
        // (The button above takes the click; this only listens for the keys.)
        focus-on-click: false;
        key-pressed(e) => {
            if !Settings.recording { return reject; }
            if e.text == Key.Escape { Settings.record(false); return accept; }
            Settings.keys-pressed(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
            accept
        }
        changed has-focus => { if !self.has-focus && Settings.recording { Settings.record(false); } }
    }
}

// A setting: its name and a line about it on the left, what changes it on the right (or underneath, `wide`).
component SetRow inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    HorizontalLayout {
        padding-top: 11px;
        padding-bottom: 11px;
        spacing: 18px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text { text: root.label; color: Look.text; font-size: 13.5px; font-weight: 600; }
            if root.hint != "": Text { text: root.hint; color: Look.faint; font-size: 12px; wrap: word-wrap; }
        }
        VerticalLayout { alignment: center; horizontal-stretch: 0; @children }
    }
    Rectangle { height: 1px; background: Look.edge; }
}
component WideRow inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    VerticalLayout {
        padding-top: 11px;
        padding-bottom: 11px;
        spacing: 8px;
        VerticalLayout {
            spacing: 3px;
            Text { text: root.label; color: Look.text; font-size: 13.5px; font-weight: 600; }
            if root.hint != "": Text { text: root.hint; color: Look.faint; font-size: 12px; wrap: word-wrap; }
        }
        HorizontalLayout { alignment: start; @children }
    }
    Rectangle { height: 1px; background: Look.edge; }
}

// A look: its colours, its name and a line about it; ringed when it's the one.
component LookCard inherits Rectangle {
    in property <LookChoice> look;
    callback picked;
    height: 52px;
    Shape {
        width: 100%;
        height: 100%;
        radius: 10px;
        fill: root.look.on ? Look.accent.with-alpha(0.12) : lta.has-hover ? #ffffff0d : #ffffff06;
        stroke: root.look.on ? Look.accent.with-alpha(0.6) : #ffffff1a;
    }
    lta := TouchArea { mouse-cursor: pointer; clicked => { root.picked(); } }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 70px;
                height: 24px;
                border-radius: 6px;
                clip: true;
                border-width: 1px;
                border-color: #ffffff1f;
                HorizontalLayout { for c in root.look.swatches: Rectangle { background: c; } }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text { text: root.look.label; color: Look.text; font-size: 13.5px; font-weight: 600; }
            Text { text: root.look.blurb; color: Look.faint; font-size: 12px; }
        }
    }
}

// A section in the list on the left.
component NavItem inherits Rectangle {
    in property <string> id;
    in property <string> text;
    height: 32px;
    border-radius: 8px;
    background: Settings.section == root.id ? Look.accent.with-alpha(0.18) : nta.has-hover ? #ffffff0d : transparent;
    nta := TouchArea { mouse-cursor: pointer; clicked => { Settings.section = root.id; } }
    Text { x: 12px; text: root.text; color: Settings.section == root.id ? Look.text : Look.muted; font-size: 13.5px; vertical-alignment: center; height: parent.height; }
}

component SettingsBody inherits Rectangle {
    VerticalLayout {
        padding: 16px;
        padding-top: 12px;
        spacing: 10px;
        // Its name (drag here to move it) and × to close it.
        HorizontalLayout {
            height: 36px;
            spacing: 6px;
            Rectangle {
                horizontal-stretch: 1;
                DragArea { }
                Text { x: 2px; text: "Settings"; color: Look.text; font-family: "Instrument Serif"; font-size: 26px; vertical-alignment: center; height: parent.height; }
            }
            VerticalLayout { alignment: center; NavButton { text: "×"; clicked => { Settings.close(); } } }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 14px;
            VerticalLayout {
                width: 128px;
                spacing: 2px;
                alignment: start;
                NavItem { id: "desktop"; text: "Desktop"; }
                NavItem { id: "cards"; text: "Cards"; }
                NavItem { id: "look"; text: "Look"; }
                NavItem { id: "tasks"; text: "Tasks"; }
                NavItem { id: "about"; text: "About"; }
            }
            Rectangle { width: 1px; background: Look.edge; }
            fl := Flickable {
                horizontal-stretch: 1;
                content-width: self.width;
                content-height: max(self.height, page.preferred-height);
                page := VerticalLayout {
                    width: fl.width;
                    padding-right: 6px;
                    alignment: start;
                    if Settings.section == "desktop": VerticalLayout {
                        SetRow {
                            label: "Show and hide";
                            hint: Settings.keys-note;
                            KeysButton { }
                        }
                        SetRow {
                            label: "The Esther bubble";
                            hint: "“Esther” on the desktop: hiding gathers the cards into it; click it and they come back out.";
                            Switch { on: Settings.bubble; toggled => { Settings.set("bubble", Settings.bubble ? "0" : "1"); } }
                        }
                        if Settings.bubble: SetRow {
                            label: "Bubble size";
                            hint: "How big “Esther” is in the middle of the screen. The mouse wheel over it changes it too.";
                            Slider {
                                value: Settings.bubble-size;
                                min: 0.3;
                                max: 1.5;
                                shown: round(Settings.bubble-size * 100) + "%";
                                moved-to(v) => { Settings.set("bubble-size", v); }
                                done(v) => { Settings.set("bubble-size", v); }
                            }
                        }
                        SetRow {
                            label: "Snap cards into line";
                            hint: "While you move or resize a card, the grid shows and the card snaps to the guides.";
                            Switch { on: Settings.snap; toggled => { Settings.set("snap", Settings.snap ? "0" : "1"); } }
                        }
                        SetRow {
                            label: "Start with Windows";
                            hint: "Esther opens when you sign in.";
                            Switch { on: Settings.startup; toggled => { Settings.set("startup", Settings.startup ? "0" : "1"); } }
                        }
                    }
                    if Settings.section == "cards": VerticalLayout {
                        for c in Settings.cards: SetRow {
                            label: c.label;
                            hint: c.hint;
                            Switch { on: c.on; toggled => { Settings.set("card", c.id); } }
                        }
                        SetRow {
                            label: "Put the cards back";
                            hint: "Every card goes back to where it started. Double-clicking the Esther logo does this too.";
                            Button { text: "Put back"; clicked => { Settings.set("put-back", ""); } }
                        }
                    }
                    if Settings.section == "look": VerticalLayout {
                        VerticalLayout {
                            padding-top: 4px;
                            padding-bottom: 8px;
                            spacing: 6px;
                            for l in Settings.looks: LookCard { look: l; picked => { Settings.set("look", l.id); } }
                        }
                        SetRow {
                            label: "Panel colour";
                            hint: "Text turns light or dark by itself to stay readable.";
                            Swatches { swatches: Settings.panels; picked(i) => { Settings.set("panel", i); } }
                        }
                        SetRow {
                            label: "Opacity";
                            hint: "How solid the panels are.";
                            Slider {
                                value: Settings.opacity;
                                min: 0.2;
                                max: 1;
                                shown: round(Settings.opacity * 100) + "%";
                                moved-to(v) => { Settings.set("opacity", v); }
                                done(v) => { Settings.set("opacity-done", v); }
                            }
                        }
                        if Settings.acrylic-ok: WideRow {
                            label: "Glass";
                            hint: Settings.glass == "acrylic" ? "Windows blurs whatever is behind each card, live, like its own menus." : "Esther blurs a copy of your wallpaper, and you choose how much.";
                            Choices {
                                choices: [{ id: "acrylic", label: "Windows acrylic", on: Settings.glass == "acrylic" }, { id: "esther", label: "Esther’s own", on: Settings.glass == "esther" }];
                                picked(id) => { Settings.set("glass", id); }
                            }
                        }
                        if Settings.glass == "esther": SetRow {
                            label: "Blur behind the cards";
                            hint: "How much the wallpaper behind each card is blurred. 0 shows it sharp.";
                            Slider {
                                value: Settings.blur;
                                min: 0;
                                max: 60;
                                shown: round(Settings.blur) + " px";
                                moved-to(v) => { Settings.set("blur-moving", v); }
                                done(v) => { Settings.set("blur", v); }
                            }
                        }
                        SetRow {
                            label: "Highlight colour";
                            hint: "Today, the picked tab, ticks and buttons.";
                            Swatches { swatches: Settings.accents; picked(i) => { Settings.set("accent", i); } }
                        }
                        SetRow {
                            label: "Start over";
                            hint: "The look’s own panel, highlight, opacity and glass.";
                            Button { text: "Reset"; clicked => { Settings.set("reset-look", ""); } }
                        }
                    }
                    if Settings.section == "tasks": VerticalLayout {
                        WideRow {
                            label: "Finished tasks";
                            hint: "They stay crossed out, then clear themselves.";
                            Choices { choices: Settings.clear-choices; picked(id) => { Settings.set("clear-days", id); } }
                        }
                        SetRow {
                            label: "Save a copy";
                            hint: Settings.copy-note;
                            Button { text: "Save"; clicked => { Settings.set("save-copy", ""); } }
                        }
                    }
                    if Settings.section == "about": VerticalLayout {
                        SetRow {
                            label: "Esther " + Settings.version;
                            hint: "A to-do list that lives on your desktop. This build doesn’t update itself yet: new ones come from the Esther native release page.";
                        }
                        SetRow {
                            label: "Memory";
                            hint: Settings.memory;
                        }
                        SetRow {
                            label: "Quit Esther";
                            hint: "Closes every card. The tray icon by the clock has these settings too.";
                            Button { text: "Quit"; danger: true; clicked => { Settings.set("quit", ""); } }
                        }
                    }
                }
            }
        }
    }
}

export component Card inherits Window {
    // "header", "tasks", "calendar", "week" or "bubble"
    in property <string> kind: "tasks";
    title: root.kind == "header" ? "Esther" : root.kind == "calendar" ? "Esther · Calendar" : root.kind == "week" ? "Esther · This week" : root.kind == "bubble" ? "Esther bubble" : root.kind == "settings" ? "Esther · Settings" : "Esther · Tasks";
    no-frame: true;
    // Over Windows' own acrylic the window is see-through, and only the tint is drawn.
    background: root.acrylic || root.kind == "bubble" ? transparent : Look.panel;
    // (Windows' own UI font, as the Esther app falls back to.)
    default-font-family: "Segoe UI";
    default-font-size: 13px;
    min-width: root.kind == "header" ? 420px : root.kind == "week" ? 280px : root.kind == "bubble" ? 40px : root.kind == "settings" ? 520px : 300px;
    min-height: root.kind == "header" ? 96px : root.kind == "calendar" ? 330px : root.kind == "week" ? 220px : root.kind == "bubble" ? 20px : root.kind == "settings" ? 400px : 260px;

    // Glass. Where Windows can, its own acrylic (live, blurred, done by Windows): `acrylic`. Otherwise Esther's: the
    // blurred wallpaper with the panel's tint already in it, at the screen's own size, slid into line with the real
    // wallpaper behind the window (drawn pixel for pixel: smooth, and quick to draw).
    in property <bool> acrylic;
    in property <bool> has-glass;
    in property <image> glass;
    in property <length> glass-x;
    in property <length> glass-y;
    in property <length> glass-w;
    in property <length> glass-h;

    if root.kind != "bubble": Rectangle {
        clip: true;
        if root.has-glass: Image {
            source: root.glass;
            x: root.glass-x;
            y: root.glass-y;
            width: root.glass-w;
            height: root.glass-h;
            image-fit: fill;
        }
        if root.acrylic: Rectangle { background: Look.panel.with-alpha(Look.acrylic-tint); }
        if !root.has-glass && !root.acrylic: Rectangle { background: Look.panel; }
        // A hairline of light along the top, as glass catches it, and the card's edge: both follow the corners Windows
        // rounds (8 px, as Windows 11 does).
        if root.acrylic: Rectangle { x: 8px; y: 0; width: parent.width - 16px; height: 1px; background: #ffffff1c; }
        Shape { width: 100%; height: 100%; radius: 8px; fill: transparent; stroke: Look.edge; }
    }

    if root.kind == "tasks": TasksBody { }
    if root.kind == "header": HeaderBody { }
    if root.kind == "calendar": CalendarBody { }
    if root.kind == "week": WeekBody { }
    if root.kind == "bubble": BubbleBody { }
    if root.kind == "settings": SettingsBody { }

    // Resize from any edge or corner (Esther lands it on the grid and the guides).
    if root.kind != "bubble": Rectangle {
        for e in [
            { id: "n", x: 12px, y: 0px, w: root.width - 24px, h: 6px, c: MouseCursor.ns-resize },
            { id: "s", x: 12px, y: root.height - 6px, w: root.width - 24px, h: 6px, c: MouseCursor.ns-resize },
            { id: "w", x: 0px, y: 12px, w: 6px, h: root.height - 24px, c: MouseCursor.ew-resize },
            { id: "e", x: root.width - 6px, y: 12px, w: 6px, h: root.height - 24px, c: MouseCursor.ew-resize },
            { id: "nw", x: 0px, y: 0px, w: 12px, h: 12px, c: MouseCursor.nwse-resize },
            { id: "ne", x: root.width - 12px, y: 0px, w: 12px, h: 12px, c: MouseCursor.nesw-resize },
            { id: "sw", x: 0px, y: root.height - 12px, w: 12px, h: 12px, c: MouseCursor.nesw-resize },
        ]: TouchArea {
            x: e.x;
            y: e.y;
            width: e.w;
            height: e.h;
            mouse-cursor: e.c;
            moved => { if self.pressed { Esther.resize-by(e.id, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); } }
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left { Esther.resize-start(e.id); }
                if ev.kind == PointerEventKind.up { Esther.resize-end(); }
            }
        }
    }
    // The resize corner: a small rounded line following the card's corner (as in the app), brighter under the mouse.
    if root.kind != "bubble": corner := TouchArea {
        x: root.width - 18px;
        y: root.height - 18px;
        width: 18px;
        height: 18px;
        mouse-cursor: MouseCursor.nwse-resize;
        moved => { if self.pressed { Esther.resize-by("se", self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); } }
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left { Esther.resize-start("se"); }
            if ev.kind == PointerEventKind.up { Esther.resize-end(); }
        }
        Path {
            x: 3px;
            y: 3px;
            width: 10px;
            height: 10px;
            viewbox-width: 10;
            viewbox-height: 10;
            stroke: Look.muted;
            stroke-width: 1.6px;
            fill: transparent;
            opacity: corner.has-hover || corner.pressed ? 1 : 0.4;
            animate opacity { duration: 150ms; }
            commands: "M9 2 L9 4.5 Q9 9 4.5 9 L2 9";
        }
    }
}
