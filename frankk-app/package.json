{
  "name": "esther",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "build:site": "node scripts/build-site.mjs",
    "desktop": "vite build --base ./ && electron .",
    "build:desktop": "vite build --base ./ && electron-builder --win --publish never",
    "test:desktop": "vite build --base ./ && electron scripts/desktop-smoke.cjs"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "description": "Esther: a to-do list that lives on your desktop.",
  "author": "Anousone Singsouvong",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.esther.todo",
    "productName": "Esther",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Esther-Setup-${version}.${ext}",
      "shortcutName": "Esther",
      "createDesktopShortcut": false,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Esther-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/FRANKKSONG/Frankk/releases/download/esther-desktop"
      }
    ],
    "extraResources": [
      {
        "from": "native",
        "to": "native",
        "filter": [
          "*.exe"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FRANKKSONG/Frankk.git"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "koffi": "3.3.2"
  }
}
